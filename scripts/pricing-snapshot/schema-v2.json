{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Liangwengu Pricing Snapshot v2",
  "description": "DeepSeek 峰谷定价快照。峰时窗口和假期日期均按 Asia/Shanghai 解释。",
  "type": "object",
  "required": ["schemaVersion", "sourceHash", "currency", "peakPolicy", "models"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 2,
      "description": "Pricing Snapshot v2。"
    },
    "sourceHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "由同步脚本注入；只对 DeepSeek 定价页规范化内容计算。"
    },
    "currency": {
      "type": "string",
      "const": "CNY",
      "description": "当前同步源为 DeepSeek 中文定价页，价格单位为人民币。"
    },
    "peakPolicy": {
      "type": "object",
      "required": ["timezone", "weekdaysOnly", "windows", "holidayCalendar"],
      "additionalProperties": false,
      "properties": {
        "timezone": {
          "type": "string",
          "const": "Asia/Shanghai",
          "description": "峰时窗口、星期和 holidayCalendar 日期统一按北京时间解释。"
        },
        "weekdaysOnly": {
          "type": "boolean",
          "description": "true = 仅周一至周五可有峰时；周末全天空闲，包括调休补班周末。"
        },
        "windows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["start", "end"],
            "additionalProperties": false,
            "properties": {
              "start": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
              "end": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" }
            }
          }
        },
        "holidayCalendar": {
          "type": "object",
          "required": ["coveredFrom", "coveredThrough", "excludedDates"],
          "additionalProperties": false,
          "properties": {
            "coveredFrom": {
              "type": "string",
              "format": "date",
              "description": "连续完整日历覆盖的首日，包含当天。"
            },
            "coveredThrough": {
              "type": "string",
              "format": "date",
              "description": "连续完整日历覆盖的末日，包含当天。"
            },
            "excludedDates": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "format": "date",
                "description": "中国法定休息日；当天全日按空闲时段计价。"
              }
            }
          }
        }
      }
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["modelId", "displayName", "peak", "offPeak"],
        "additionalProperties": false,
        "properties": {
          "modelId": { "type": "string", "minLength": 1 },
          "displayName": { "type": "string", "minLength": 1 },
          "peak": { "$ref": "#/$defs/periodPrices" },
          "offPeak": { "$ref": "#/$defs/periodPrices" }
        }
      }
    }
  },
  "$defs": {
    "periodPrices": {
      "type": "object",
      "required": ["inputCacheHit", "inputCacheMiss", "output"],
      "additionalProperties": false,
      "properties": {
        "inputCacheHit": { "type": "number", "minimum": 0 },
        "inputCacheMiss": { "type": "number", "minimum": 0 },
        "output": { "type": "number", "minimum": 0 }
      }
    }
  }
}
