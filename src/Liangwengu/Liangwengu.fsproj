<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net10.0;net10.0-windows10.0.17763.0</TargetFrameworks>
    <RuntimeIdentifiers>win-x64;osx-x64;osx-arm64</RuntimeIdentifiers>
    <AssemblyName>liangwengu</AssemblyName>
    <RootNamespace>Liangwengu</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Version>0.1.0</Version>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
    <DebugType>embedded</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <!-- Windows 特定配置 -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-windows10.0.17763.0'">
    <DefineConstants>$(DefineConstants);WIN32</DefineConstants>
  </PropertyGroup>

  <!-- Windows GUI 应用不显示控制台；通用目标保留 Exe 供 macOS/Linux 使用。 -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-windows10.0.17763.0'">
    <OutputType>WinExe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <!-- 领域 -->
    <Compile Include="Domain\PricingSchema.fs" />
    <Compile Include="Domain\Domain.fs" />
    <!-- 基础设施 -->
    <Compile Include="Infrastructure\PricingFetcher.fs" />
    <!-- 平台适配 -->
    <Compile Include="Platform\Native.fs" />
    <Compile Include="Platform\SingleInstance.fs" />
    <Compile Include="Platform\Autostart.fs" />
    <Compile Include="Platform\Notify.Windows.fs" Condition="'$(TargetFramework)' == 'net10.0-windows10.0.17763.0'" />
    <Compile Include="Platform\Notify.Mac.fs" Condition="'$(TargetFramework)' == 'net10.0'" />
    <Compile Include="Platform\Notification.fs" />
    <!-- 应用服务 -->
    <Compile Include="Application\PricingRefreshState.fs" />
    <Compile Include="Application\PricingRefreshService.fs" />
    <!-- 托盘 UI -->
    <Compile Include="Presentation\TrayMenu.fs" />
    <Compile Include="Presentation\TrayView.fs" />
    <Compile Include="Presentation\TrayApplication.fs" />
    <!-- UI 入口 -->
    <Compile Include="App.fs" />
    <!-- 程序入口（必须是最后一个） -->
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.*" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.*" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.*" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.*" />
    <!-- M4 自定义面板(MVU)前基本不用，按既定决策保留引用 -->
    <PackageReference Include="Avalonia.FuncUI" Version="2.0.0" />
    <PackageReference Include="FSharp.SystemTextJson" Version="1.4.36" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <!-- pricing.json 既是远程托管源也是编译期内嵌兜底，单一来源 -->
    <EmbeddedResource Include="..\..\pricing.json" LogicalName="liangwengu.pricing.json" />
  </ItemGroup>

</Project>
